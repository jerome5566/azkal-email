# ---- Database ----
DATABASE_URL=postgres://azkal:CHANGE_ME@127.0.0.1:5432/azkal_email

# ---- Session ----
# Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---- Sending identity (used from Sprint 3 onward) ----
MAIL_FROM_NAME=Azkal Media
MAIL_FROM_EMAIL=hello@azkalmedia.agency
MAIL_REPLY_TO=you@azkalmedia.com
MAIL_BOUNCE_DOMAIN=azkalmedia.agency

# ---- OVH Postfix SMTP (leave blank until the mail server exists) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- App ----
APP_TIMEZONE=Asia/Dubai
NODE_ENV=production
